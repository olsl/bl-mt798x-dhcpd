// SPDX-License-Identifier: GPL-2.0
/*
 * KJD KJ30-N (MT7981 + SPI-NAND, 128MB / 256MB DDR)
 *
 * U-Boot device tree for bl-mt798x-dhcpd.
 *
 * 多分区启动 (/mtd-layout)：
 *   default      - ImmortalWrt/OpenWrt 114M ubi（KJ30-N 现行布局）
 *   ikuai        - iKuai Q3000 原厂布局（ubi 64M + panic_oops + ikuai_cfg 16M）
 *   ikuai-dual   - 上面这套 + 尾部剩余空间再划一个 ubi2，用于 OpenWrt 双系统
 *
 * 切换方法（U-Boot 命令行）：
 *   setenv mtd_layout_label ikuai ; saveenv ; reset
 * 或开机在 bootmenu 里选 / 用 failsafe 网页查看当前布局。
 *
 * 前四个分区（bl2 / u-boot-env / factory / fip）的偏移与 IK-Q3000 固件 DTB
 * 中声明的 Bootloader/Config/Factory/FIP 完全一致，因此 iKuai 的 kernel DTB
 * 无需修改即可匹配。
 */

/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "mt7981-kjd-kj30-n";
	compatible = "mediatek,mt7981", "mediatek,mt7981-rfb";

	chosen {
		stdout-path = &uart0;
		tick-timer = &timer0;
	};

	config {
		bootcmd = "mtkboardboot";
		blink_led = "blue:internet";
		system_led = "yellow:system";
	};

	mtd-layout {
		layout@0 {
			label = "default";
			// ImmortalWrt / OpenWrt 114M ubi（KJ30-N 出厂 OpenWrt 布局）
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(factory),2048k(fip),116736k(ubi)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};

		layout@1 {
			label = "ikuai";
			// iKuai Q3000 原厂布局：ubi 64M + panic_oops 256k + ikuai_cfg 16M
			// 与 IK-Q3000_3.7.5 固件自带 DTB 的分区表一一对应
			cmdline = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000 clk_ignore_unused";
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(factory),2048k(fip),64M(ubi),256k(panic_oops),16M(ikuai_cfg),-(ikuai_log)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};

		layout@2 {
			label = "ikuai-dual";
			// iKuai 64M 在前，尾部剩余空间作为第二套 ubi2 给 OpenWrt 双系统
			// 切到 ubi2 启动：setenv ubi_boot_part ubi2
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(factory),2048k(fip),64M(ubi),256k(panic_oops),16M(ikuai_cfg),-(ubi2)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};

		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "blue:internet";
			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			label = "yellow:internet";
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			label = "blue:system";
			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			label = "yellow:system";
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
			default-state = "on";
			linux,default-trigger = "default-on";
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x10000000>;
	};

	bl2_verify {
		bl2_compatible = "spim-nand";
	};
};

&uart0 {
	status = "okay";
};

&eth {
	status = "okay";
	mediatek,gmac-id = <0>;
	phy-mode = "2500base-x";
	mediatek,switch = "auto";
	reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&pio {
	spi_flash_pins: spi0-pins-func-1 {
		mux {
			function = "flash";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi_flash_pins>;
	status = "okay";
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;

	spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
	};
};

&watchdog {
	status = "disabled";
};
