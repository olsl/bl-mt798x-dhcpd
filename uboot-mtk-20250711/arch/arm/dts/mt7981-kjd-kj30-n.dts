// SPDX-License-Identifier: GPL-2.0
/*
 * KJD KJ30-N (MT7981 + SPI-NAND, 128MB / 256MB DDR)
 *
 * U-Boot device tree for bl-mt798x-dhcpd.
 *
 * 多分区启动 (/mtd-layout)：
 *   default     - ImmortalWrt/OpenWrt 114M ubi（KJ30-N 现行布局，保持为默认，刷完不动就能起）
 *   stock-64m   - 原厂 64M 布局：与 KJ30-N 自带 U-Boot DTB、以及 iKuai AX320C-NA/AX323W-NA
 *                 固件 DTB 完全一致（ubi 都落在 0x580000、都是 64M）
 *
 * 切换方法（U-Boot 命令行）：
 *   setenv mtd_layout_label stock-64m ; saveenv ; mtd erase ubi ; reset
 * 注意：改布局不会重建 UBI，切完必须 mtd erase ubi 再刷固件。
 * 可用 `showlayout` 命令查看全部布局，或进 failsafe 网页看当前布局。
 *
 * 命名遵循上游 bl-mt798x-dhcpd 的惯例：layout@0 必须叫 "default"，
 * 其余用 "<固件>-<容量>"（如 immortalwrt-112m / stock-64m）。
 * 选择逻辑见 board/mediatek/common/mtd_layout.c：
 *   读环境变量 mtd_layout（新）→ 回退 mtd_layout_label（旧）→ 都没有则 "default"
 */

/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "mt7981-kjd-kj30-n";
	compatible = "mediatek,mt7981", "mediatek,mt7981-rfb";

	chosen {
		stdout-path = &uart0;
		tick-timer = &timer0;
	};

	config {
		bootcmd = "mtkboardboot";
		blink_led = "blue:internet";
		system_led = "yellow:system";
	};

	mtd-layout {
		layout@0 {
			label = "default";
			// ImmortalWrt / OpenWrt 114M ubi —— KJ30-N 现行布局，刷完不用动就能跑 OpenWrt
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(factory),2048k(fip),116736k(ubi)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};

		layout@1 {
			label = "stock-64m";
			// 原厂 64M 布局 —— 与 KJ30-N 自带 U-Boot DTB 的分区表逐字节一致：
			//   BL2 0x0 1M / u-boot-env 0x100000 512K / Factory 0x180000 2M /
			//   FIP 0x380000 2M / ubi 0x580000 64M
			// iKuai 8.1（AX320C-NA / AX323W-NA）固件 DTB 也是 ubi 0x580000 64M，
			// 只是把 FIP 缩成 1.75M 并多切了一个 256K 的 opt —— ubi 的起点和长度相同，
			// 所以跑 iKuai 系固件就选这套。
			cmdline = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000 clk_ignore_unused";
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(Factory),2048k(fip),64M(ubi)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		/*
		 * 必须与 KJ30-N 设备自带 DTB 一致（反编译来源：kj30-n.dts）：
		 *   wps     -> pio 0, flags 0x00 = 高有效（按下为高，常态低）
		 *   factory -> pio 1, flags 0x01 = 低有效（按下为低，常态高）
		 * 注意：这里的极性写反会直接导致 U-Boot 把"常态"当成"按住"，
		 * 每次冷启动都进 failsafe WEBUI（log 表现：wps is pressed for: N second(s)）。
		 * 子节点 name 用 reset/wps，因为 U-Boot 的 glbtn 按这两个 label 找按键。
		 */
		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};

		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "blue:internet";
			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			label = "yellow:internet";
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			label = "blue:system";
			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			label = "yellow:system";
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
			default-state = "on";
			linux,default-trigger = "default-on";
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x10000000>;
	};

	bl2_verify {
		bl2_compatible = "spim-nand";
	};
};

&uart0 {
	status = "okay";
};

&eth {
	status = "okay";
	mediatek,gmac-id = <0>;
	phy-mode = "2500base-x";
	mediatek,switch = "auto";
	reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&pio {
	spi_flash_pins: spi0-pins-func-1 {
		mux {
			function = "flash";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi_flash_pins>;
	status = "okay";
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;

	spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
	};
};

&watchdog {
	status = "disabled";
};
